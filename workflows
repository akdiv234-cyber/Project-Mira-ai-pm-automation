        "jsCode": "\n// Read outputs directly from the three agent nodes\nfunction getAgentOutput(nodeName) {\n  let data = $(nodeName).first().json;\n\n  // Unwrap nested output and parse JSON strings\n  for (let i = 0; i < 4; i++) {\n    if (typeof data === \"string\") {\n      data = data\n        .replace(/^```(?:json)?\\s*/i, \"\")\n        .replace(/\\s*```$/, \"\")\n        .trim();\n      data = JSON.parse(data);\n      continue;\n    }\n\n    if (Array.isArray(data) && data.length === 1) {\n      data = data[0];\n      continue;\n    }\n\n    if (data && typeof data === \"object\" && data.output !== undefined) {\n      data = data.output;\n      continue;\n    }\n\n    break;\n  }\n\n  return data;\n}\n\nconst planning = getAgentOutput(\"Planning Agent\");\nconst risk = getAgentOutput(\"Risk Agent\");\nconst validation = getAgentOutput(\"Validation Agent\");\n\n// Find arrays such as risks, issues and warnings, including nested arrays\nfunction findArray(obj, possibleKeys) {\n  if (!obj || typeof obj !== \"object\") return [];\n\n  for (const key of possibleKeys) {\n    if (Array.isArray(obj[key])) return obj[key];\n  }\n\n  for (const value of Object.values(obj)) {\n    if (value && typeof value === \"object\") {\n      const result = findArray(value, possibleKeys);\n      if (result.length) return result;\n    }\n  }\n\n  return [];\n}\n\nconst workItems = findArray(planning, [\"workItems\", \"work_items\"]);\nconst risks = findArray(risk, [\"risks\", \"riskRegister\", \"identifiedRisks\"]);\nconst issues = findArray(validation, [\"issues\"]);\nconst warnings = findArray(validation, [\"warnings\"]);\n\nconst validationStatus =\n  validation.validationStatus ??\n  validation.validation_status ??\n  validation.status ??\n  \"Not Provided\";\n\n// Generate one shared trace ID\nfunction randomHex(length) {\n  let result = \"\";\n  while (result.length < length) {\n    result += Math.floor(Math.random() * 16).toString(16);\n  }\n  return result.slice(0, length);\n}\n\nconst traceId = randomHex(32);\nconst endTime = BigInt(Date.now()) * 1000000n;\nconst startTime = endTime - 1000000n;\n\nfunction stringAttribute(key, value) {\n  return {\n    key,\n    value: { stringValue: String(value) }\n  };\n}\n\nfunction intAttribute(key, value) {\n  return {\n    key,\n    value: { intValue: String(value) }\n  };\n}\n\nfunction makeSpan(name, agentOutput, extraAttributes = []) {\n  return {\n    traceId,\n    spanId: randomHex(16),\n    name,\n    kind: 1,\n    startTimeUnixNano: startTime.toString(),\n    endTimeUnixNano: endTime.toString(),\n    attributes: [\n      stringAttribute(\n        \"langfuse.trace.name\",\n        \"ABCDE AI Adoption - Consolidated Agent Observability\"\n      ),\n      stringAttribute(\"langfuse.observation.type\", \"agent\"),\n      stringAttribute(\n        \"langfuse.observation.output\",\n        JSON.stringify(agentOutput)\n      ),\n      stringAttribute(\"gen_ai.operation.name\", \"invoke_agent\"),\n      stringAttribute(\"gen_ai.agent.name\", name),\n      ...extraAttributes\n    ],\n    status: { code: 1 }\n  };\n}\n\nconst spans = [\n  makeSpan(\"Planning Agent\", planning, [\n    intAttribute(\"planning.work_item_count\", workItems.length)\n  ]),\n\n  makeSpan(\"Risk Agent\", risk, [\n    intAttribute(\"risk.count\", risks.length)\n  ]),\n\n  makeSpan(\"Validation Agent\", validation, [\n    stringAttribute(\"validation.status\", validationStatus),\n    intAttribute(\"validation.issue_count\", issues.length),\n    intAttribute(\"validation.warning_count\", warnings.length)\n  ])\n];\n\nconst payload = {\n  resourceSpans: [{\n    resource: {\n      attributes: [\n        stringAttribute(\"service.name\", \"n8n\"),\n        stringAttribute(\"project.name\", \"ABCDE Ltd. AI Adoption\")\n      ]\n    },\n    scopeSpans: [{\n      scope: {\n        name: \"n8n-consolidated-observability\",\n        version: \"1.0.0\"\n      },\n      spans\n    }]\n  }]\n};\n\nreturn [{ json: payload }];\n"
